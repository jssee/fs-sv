# SvelteKit server configuration.
# @defaultSensitive=true @defaultRequired=false
# @generateTsTypes(path=./src/env.d.ts, processEnv=none, importMetaEnv=none)
# @encryptInjectedEnv=not(isEmpty($VERCEL_ENV))
# ---

# Vercel deployment metadata used only to derive the app's canonical origin.
# @internal @public
# @type=enum(development, preview, production)
VERCEL_ENV=

# @internal @public
VERCEL_URL=

# @internal @public
VERCEL_PROJECT_PRODUCTION_URL=

# PostgreSQL connection string. Production serverless deployments must use a
# transaction-mode pooled URL (PgBouncer or the provider's pooler).
# @required @type=url
DATABASE_URL=

# Secret used to sign and encrypt authentication data.
# @required @type=string(minLength=32)
BETTER_AUTH_SECRET=

# Explicit values override these Vercel-derived defaults. Production uses the
# project's canonical URL; preview deployments use their unique deployment URL.
# @required @type=url(prependHttps=true)
BETTER_AUTH_URL=if(eq($VERCEL_ENV, production), fallback($VERCEL_PROJECT_PRODUCTION_URL, $VERCEL_URL), fallback($VERCEL_URL, $VERCEL_PROJECT_PRODUCTION_URL))

# Browser origin trusted by the auth server.
# @required @type=url(prependHttps=true)
CORS_ORIGIN=if(eq($VERCEL_ENV, production), fallback($VERCEL_PROJECT_PRODUCTION_URL, $VERCEL_URL), fallback($VERCEL_URL, $VERCEL_PROJECT_PRODUCTION_URL))
