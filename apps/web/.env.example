# Copy to apps/web/.env for local development.
# On Vercel, set these as project env vars (dashboard, or `bun run env:production`).

# Postgres connection string. In production this MUST be a transaction-mode
# pooled URL (PgBouncer or your provider's pooler) — a direct connection will
# exhaust the database's connection limit under serverless.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fs-sv

# 32+ character secret. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Auth base URL and trusted origin. On Vercel, leave these unset: they default
# to the deployment's own origin (VERCEL_URL), so previews work automatically.
BETTER_AUTH_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
