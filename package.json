{
  "name": "fs-sv",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^6",
      "@types/node": "^22.13.14",
      "@orpc/server": "^2.0.0-beta.32",
      "@orpc/openapi": "^2.0.0-beta.32",
      "@orpc/contract": "^2.0.0-beta.32",
      "better-auth": "1.6.9",
      "evlog": "^2.19.1",
      "valibot": "^1.3.1",
      "@orpc/valibot": "^2.0.0-beta.32",
      "varlock": "^1.16.0",
      "@varlock/vite-integration": "^1.4.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check": "turbo check",
    "dev:web": "turbo -F web dev",
    "db:push": "turbo -F @fs-sv/db db:push",
    "db:studio": "turbo -F @fs-sv/db db:studio",
    "db:generate": "turbo -F @fs-sv/db db:generate",
    "db:migrate": "turbo -F @fs-sv/db db:migrate",
    "db:start": "turbo -F @fs-sv/db db:start",
    "db:watch": "turbo -F @fs-sv/db db:watch",
    "db:stop": "turbo -F @fs-sv/db db:stop",
    "db:down": "turbo -F @fs-sv/db db:down",
    "env:check": "bun run --cwd apps/web env:check",
    "lint": "ultracite check",
    "fix": "ultracite fix",
    "deploy:setup": "bunx vercel link"
  },
  "devDependencies": {
    "@fs-sv/config": "workspace:*",
    "@biomejs/biome": "2.4.14",
    "@types/node": "catalog:",
    "lefthook": "latest",
    "turbo": "^2.8.12",
    "typescript": "catalog:",
    "ultracite": "7.6.3",
    "vercel": "^54.18.6"
  },
  "packageManager": "bun@1.3.8"
}
